# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poke-martech

# Better Auth
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Object storage — MinIO in development (docker/minio).
# Production (Cloudflare R2): clear S3_ENDPOINT and set R2_ACCOUNT_ID.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=poke-martech
R2_PUBLIC_URL=http://localhost:9000/poke-martech

# AI card generation (admin > Cartas > Gerar com IA)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# Microsoft Clarity — ID do projeto em https://clarity.microsoft.com/
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Sentry. O DSN é público e vale para o browser e para o servidor.
# Org, project e token servem só para enviar source maps no build.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Feature flags. true (ou vazio) mantém a função ligada; false desliga.
# Cada avaliação é enviada ao Sentry junto com erros e traces.
FEATURE_FLAG_BATTLE=true
FEATURE_FLAG_AI_CARD_GENERATION=true
FEATURE_FLAG_OPPONENT_REGISTRATION=true
