{
  "name": "poke-martech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:migrate": "drizzle-kit migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-admin": "tsx scripts/seed-admin.ts",
    "db:seed-genetic-apex": "tsx scripts/seed-genetic-apex.ts",
    "minio:dev": "docker build -t poke-martech-minio docker/minio && (docker rm -f poke-martech-minio >/dev/null 2>&1 || true) && docker run --name poke-martech-minio -p 9000:9000 -p 9001:9001 -v poke-martech-minio:/data poke-martech-minio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@base-ui/react": "^1.8.0",
    "@microsoft/clarity": "^1.0.2",
    "@sentry/nextjs": "^11.4.0",
    "@tanstack/react-query": "^5.104.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "openai": "^7.28.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
